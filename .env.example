APP_NAME="ELARA Beauté Studio Management System"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://elara.datapointtechnology.com"

# Parlor Branding & Settings
PARLOR_NAME="ELARA Luxury Parlor & Spa"
PARLOR_TAGLINE="Elegance, Wellness & Rejuvenation for Modern Women"
PARLOR_ADDRESS="452 Orchid Boulevard, Suite 3B, Luxury District"
PARLOR_PHONE="+1 (555) 789-2580"
PARLOR_WHATSAPP="+15557892580"
PARLOR_EMAIL="concierge@elaraparlor.com"
CURRENCY_SYMBOL="$"
CURRENCY_CODE="USD"
PARLOR_TAX_RATE=8.0
PARLOR_TAX_NAME="Service Tax"

# Google Cloud Firestore Configuration
GOOGLE_APPLICATION_CREDENTIALS="serviceAccountKey.json"
FIRESTORE_PROJECT_ID="your-gcp-project-id"
FIRESTORE_DATABASE="(default)"
FIRESTORE_EMULATOR_FALLBACK=true

# AI Assistant (ELARA) Settings
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-1.5-flash"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

