APP_NAME="ELARA Beauté Studio Management System"
APP_ENV="production"
APP_DEBUG=false
APP_URL="https://elara.datapointtechnology.com"

# Parlor Branding & Settings - Pakistan Based Beauté Studio
PARLOR_NAME="ELARA BEAUTÉ STUDIO"
PARLOR_TAGLINE="By Elia & Sahar"
PARLOR_SUBTITLE="Haute Beauté & Luxury Wellness Studio"
PARLOR_ADDRESS="Main Qasimabad Road, near Ali CNG, Hyderabad, Sindh, Pakistan"
PARLOR_CITY="Hyderabad"
PARLOR_COUNTRY="Pakistan"
PARLOR_PHONE="0335 2004959"
PARLOR_WHATSAPP="+923352004959"
PARLOR_EMAIL="concierge@elarabeaute.pk"
PARLOR_INSTAGRAM="https://www.instagram.com/elarabeautestudio/"
PARLOR_FACEBOOK="https://www.facebook.com/elarabeautestudio"
PARLOR_TIKTOK="https://www.tiktok.com/@elarabeautestudio"
CURRENCY_SYMBOL="Rs. "
CURRENCY_CODE="PKR"
PARLOR_TAX_RATE=5.0
PARLOR_TAX_NAME="Sales Tax (PRA/SRB)"

# Google Cloud Firestore Configuration
# Place your serviceAccountKey.json in the application root on cPanel
GOOGLE_APPLICATION_CREDENTIALS="serviceAccountKey.json"
FIRESTORE_PROJECT_ID="elara-parlor-demo"
FIRESTORE_DATABASE="(default)"
FIRESTORE_EMULATOR_FALLBACK=true

# AI Assistant (ELARA) Settings - Google Gemini
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Session & Security
SESSION_LIFETIME=86400

