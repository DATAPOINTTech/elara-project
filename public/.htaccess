# ==============================================================================
# ELARA BEAUTÉ STUDIO - PUBLIC FOLDER REWRITE CONTROLLER
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If physical file or directory exists, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise forward all routing to Front Controller index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>
